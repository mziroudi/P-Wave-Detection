/data/
*.hdf5
*.h5
*.csv
!requirements.txt
!docs/assets/data/charts.js

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

